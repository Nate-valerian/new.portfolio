{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/tech-dolphin/index.html"
    },
    {
      "source": "/projects",
      "destination": "/tech-dolphin/projects.html"
    },
    {
      "source": "/(.*)",
      "destination": "/tech-dolphin/$1"
    }
  ]
}
